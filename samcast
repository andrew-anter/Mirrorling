#!/usr/bin/env bash
# samsung-cast: wireless desktop mirroring from this laptop to the Samsung
# 58CU7000 (Tizen AirPlay 2) via the doubletake-samsung fork.
#
# Config: ~/.config/samsung-cast/config (sourced shell, written on first run)
# Saved TVs: ~/.config/samsung-cast/tvs (one name per line, MRU first)
# Logs:   journalctl --user -u samsung-cast
#
# Copyright (C) 2026 samsung-cast contributors. All rights reserved.
# Closed source — see README. Builds against the LGPL-3.0 doubletake-samsung
# fork (separate repo, ../doubletake-samsung), invoked as a separate process.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOUBLETAKE="$SCRIPT_DIR/bin/doubletake"
CTL="$SCRIPT_DIR/bin/doubletake-ctl"
UI_BIN="$SCRIPT_DIR/bin/samcast-ui"
TRAY_BIN="$SCRIPT_DIR/bin/samcast-tray"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/samsung-cast"
CONF="$CONF_DIR/config"
KNOWN_TVS="$CONF_DIR/tvs"  # TVs the user picked at least once (see known_tvs)
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCK="$RUNTIME_DIR/doubletake.sock"
UNIT="samsung-cast"

# First run: write a config with working defaults for this TV.
if [ ! -f "$CONF" ]; then
    mkdir -p "$CONF_DIR"
    cat > "$CONF" <<'EOF'
# samsung-cast configuration (sourced by samcast)
SAMCAST_NAME="Sam58"            # mDNS service name of the TV (see: samcast tvs / samcast tv)
SAMCAST_FPS=60                  # capture frame rate (30 saves Wi-Fi bandwidth)
SAMCAST_HWACCEL=auto            # auto | vaapi | nvenc | openh264 | none
SAMCAST_PORT_RANGE="60000-60010"
SAMCAST_TIMING="NTP"            # NTP | PTP — CU7000 advertises PTP but SETUP omits ClockID (upstream #30)
SAMCAST_EXTRA_FLAGS=""          # extra doubletake flags, e.g. "-bitrate 4500 -no-audio"
SAMCAST_MONITOR=""              # monitor to cast ("" = picker dialog per cast; see: samcast monitor / samcast monitors)
EOF
    echo "samsung-cast: wrote default config to $CONF"
fi
# shellcheck source=/dev/null
source "$CONF"

# Samsung Tizen advertises PTP but its SETUP omits timingPeerInfo.ClockID —
# force NTP unless overridden (upstream doubletake issue #30, Finding 3).
export DOUBLETAKE_TIMING="${SAMCAST_TIMING:-NTP}"

# Configs written before monitor selection predate this key.
SAMCAST_MONITOR="${SAMCAST_MONITOR:-}"

usage() {
    cat <<EOF
samsung-cast — mirror this desktop to "$SAMCAST_NAME" (Samsung AirPlay 2)

  samcast discover        list Samsung AirPlay receivers on the LAN
  samcast target          print resolved TV IP
  samcast pair            first-time pairing (PIN appears on the TV)
  samcast start           start the background daemon (systemd-run --user)
  samcast stop            stop the daemon
  samcast status          daemon + stream status
  samcast on [PIN]        start mirroring (same as: samcast mirror)
  samcast mirror [PIN]    mirror the current screen to the TV
  samcast off             stop mirroring
  samcast toggle          mirror on <-> off (bind this to a key)
  samcast devices         devices the daemon can see
  samcast monitors        list connectable monitors (Hyprland outputs / X11 screens)
  samcast monitor [NAME|auto]
                          show or set the monitor to cast (auto = picker dialog per cast)
  samcast tvs             list Samsung TVs seen on the LAN or saved earlier (the configured one is marked)
  samcast tv [NAME|--forget NAME]
                          show, set, or forget the TV to cast (a name is always required; no auto)
  samcast log [-f]        daemon logs (journalctl)
  samcast ui [--port N] [--no-open|--browser]
                          serve the control panel and open its window
  samcast tray [enable|disable|status]
                          tray icon in the bar (waybar/StatusNotifier): shows the
                          mirroring state and opens the panel even when its
                          window is closed; enable installs a user service

--raw after tvs/tv/monitors/monitor prints machine-readable output, for the UI.

Env overrides after config: SAMCAST_NAME, SAMCAST_FPS, SAMCAST_HWACCEL,
SAMCAST_PORT_RANGE, SAMCAST_EXTRA_FLAGS, SAMCAST_MONITOR.
EOF
}

die() { echo "samsung-cast: $*" >&2; exit 1; }

# Persist KEY="VALUE" in $CONF: sed-replace the existing line, append when the
# key is missing (configs written before a feature predate its variable).
# Callers validate VALUE (monitor names are ^[A-Za-z0-9_-]+$ or empty, TV
# names via tv_name_ok), so no sed metacharacters can sneak in.
# flock-serialized: sed -i is a read-modify-write over the whole file, and
# samcast instances race each other (UI poll, tray action, keybind toggle) —
# without the lock a concurrent writer's key change is silently dropped.
set_config_var() {
    local key="$1" value="$2"
    (
        flock 9
        if grep -q "^${key}=" "$CONF"; then
            sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$CONF"
        else
            printf '%s="%s"\n' "$key" "$value" >> "$CONF"
        fi
    ) 9>> "$CONF.lock"
}

# TV names are free-form mDNS service names (spaces are legitimate — the $4
# parse already truncates at the first space, a pre-existing limitation), but
# they land inside a sed replacement and a quoted line of sourced shell: '|'
# breaks the sed delimiter, '"' breaks the quoting, '\' and '&' are sed
# replacement metacharacters, '$' and '`' would execute as command
# substitution when the config is sourced on every samcast run, and a newline
# would inject a config line. Exactly that set is refused — nothing more.
tv_name_ok() {
    case "$1" in
        *'|'*|*'"'*|*'\'*|*'&'*|*'$'*|*'`'*|*$'\n'*) return 1 ;;
    esac
    return 0
}

# Capture-capable monitor names, one per line, on stdout. Wayland/Hyprland is
# the primary target (names are Hyprland outputs; hyprctl missing/failing
# there is terminal — no xrandr guesswork); xrandr covers the X11 fallback.
# Neither session → print nothing, caller decides. The space in `/ connected/`
# keeps xrandr's "disconnected" from matching.
list_monitors() {
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        hyprctl monitors 2>/dev/null | awk '$1=="Monitor"{print $2}' || true
    elif [ -n "${DISPLAY:-}" ]; then
        xrandr --query 2>/dev/null | awk '/ connected/ {print $1}' || true
    fi
}

# One parse of the same avahi-browse invocation resolve_target matches with:
# one line per receiver as name<TAB>ip<TAB>port<TAB>model<TAB>fw (fw may be
# empty when the TV omits fv=; port feeds tv_alive's reachability probe). Same
# $4 convention as everywhere else — service names with spaces truncate at
# their first word (pre-existing limitation, kept). Listing order is avahi's
# (unordered), as discover always printed.
scan_tvs() {
    avahi-browse -rt _airplay._tcp -t 2>/dev/null | awk '
        $1 == "=" { name = $4; next }
        name == "" { next }
        /address =/ { gsub(/[][]/, ""); sub(/^.*address = /, ""); addr[name] = $0; next }
        /port =/    { gsub(/[][]/, ""); sub(/^.*port = /, "");    port[name] = $0; next }
        match($0, /model=[^"]+/) { model[name] = substr($0, RSTART + 6, RLENGTH - 6) }
        match($0, /fv=[^"]+/)    { fw[name]    = substr($0, RSTART + 3, RLENGTH - 3) }
        END {
            for (n in addr)
                if (model[n] ~ /^U/)   # Samsung consumer models start with U (UAU7000, UE*, UN*, ...)
                    printf "%s\t%s\t%s\t%s\t%s\n", n, addr[n], port[n], model[n], fw[n]
        }' || true
}

# What the TV-selection code matches on: name<TAB>ip<TAB>model per Samsung
# receiver (the /^U/ filter in scan_tvs already drops non-Samsung and
# empty-model services). port is resolve-only, fw is display-only — both
# dropped here.
list_tvs() {
    scan_tvs | cut -f1,2,4
}

# A stale avahi record outlives the TV: standby drops its Wi-Fi but avahi
# keeps the cached service until the record's TTL lapses, so "advertised" is
# no proof the TV is there. Live therefore means advertised AND connectable:
# a sub-second TCP connect to the advertised AirPlay port (Samsung picks it
# dynamically, so it must come from the record). 1s absorbs unroutable
# addresses; a real TV on the LAN answers in LAN latency, so the common path
# costs almost nothing.
tv_alive() {
    local ip="$1" port="$2"
    [ -n "$ip" ] && [ -n "$port" ] || return 1
    timeout 1 bash -c 'exec 3<>/dev/tcp/$1/$2' _ "$ip" "$port" 2>/dev/null
}

# list_tvs kept only to TVs that actually answer: the rescue prompt must not
# offer a dead TV, and `tvs` must not report a powered-off one as live (a
# stale record then just falls through to the saved list). Sequential on
# purpose — typically one or two TVs, and alive ones answer immediately.
# return 0 because the loop's status is its last body command: a dead TV at
# EOF would otherwise fail the function (set -e) for callers.
list_tvs_alive() {
    local name ip port model
    while IFS=$'\t' read -r name ip port model; do
        [ -n "$name" ] || continue
        if tv_alive "$ip" "$port"; then
            printf '%s\n' "$name"$'\t'"$ip"$'\t'"$model"
        fi
    done < <(scan_tvs)
    return 0
}

# Saved TVs: every name the user ever picked, so `tvs` can keep it listed
# (greyed, offline) after standby drops the TV from the network. One name per
# line, most-recently-used first; tv_name_ok refuses newlines, so
# line-per-name cannot break, and a missing file is just an empty list.
known_tvs() {
    cat "$KNOWN_TVS" 2>/dev/null || true
}

# Prepend NAME, dropping any earlier occurrence (MRU-first). temp+mv in
# $CONF_DIR keeps an interrupted write from truncating the list; flock keeps a
# concurrent save (UI pick vs terminal rescue prompt) from dropping one of the
# two names (both rewrite the whole list).
save_known_tv() {
    local name="$1"
    mkdir -p "$CONF_DIR"
    (
        flock 9
        {
            printf '%s\n' "$name"
            grep -Fxv -e "$name" "$KNOWN_TVS" 2>/dev/null || true
        } > "$KNOWN_TVS.tmp.$$"
        mv "$KNOWN_TVS.tmp.$$" "$KNOWN_TVS"
    ) 9>> "$KNOWN_TVS.lock"
}

# Drop every exact-line match for NAME; forgetting a name that is not saved
# is a no-op, not an error. Same lock as save_known_tv: both rewrite the list.
forget_known_tv() {
    local name="$1"
    [ -f "$KNOWN_TVS" ] || return 0
    (
        flock 9
        grep -Fxv -e "$name" "$KNOWN_TVS" > "$KNOWN_TVS.tmp.$$" || true
        mv "$KNOWN_TVS.tmp.$$" "$KNOWN_TVS"
    ) 9>> "$KNOWN_TVS.lock"
}

# Terminal rescue when the configured TV is missing but other Samsung
# receivers are in sight: list them numbered and persist an explicit pick.
# No default: an empty/invalid answer must NOT cast to whichever other room's
# TV happens to be up — it returns 1 so the caller dies with its usual
# message. Everything goes to stderr: resolve_target's callers (cmd_target)
# print values on stdout. Caller checks the TTY — keybindings never see this.
select_tv() {
    local rows name ip model count=0 pick chosen
    local -a opts=()
    rows="$(list_tvs_alive)"
    [ -n "$rows" ] || return 1
    echo "'$SAMCAST_NAME' not found on the network — other Samsung receivers in sight:" >&2
    while IFS=$'\t' read -r name ip model; do
        [ -n "$name" ] || continue
        opts+=("$name"$'\t'"$ip"$'\t'"$model")
        count=$((count + 1))
        printf '  [%d] %s  %s  model=%s\n' "$count" "$name" "$ip" "$model" >&2
    done <<<"$rows"
    [ "$count" -gt 0 ] || return 1
    if ! read -r -p "Cast to: " pick; then
        return 1  # stdin closed mid-prompt — keep the configured TV
    fi
    if [ "$pick" -eq "$pick" ] 2>/dev/null && [ "$pick" -ge 1 ] && [ "$pick" -le "$count" ]; then
        chosen="${opts[$((pick - 1))]}"
    else
        echo "samsung-cast: '$pick' is not a menu option" >&2
        return 1
    fi
    IFS=$'\t' read -r name ip model <<<"$chosen"
    tv_name_ok "$name" || return 1  # hostile mDNS name — refuse, caller dies below
    set_config_var SAMCAST_NAME "$name"
    SAMCAST_NAME="$name"
    save_known_tv "$name"
    echo "will cast '$name' — run 'samcast pair' before the first cast to this TV" >&2
}

# The resolve_target matcher, factored so the post-pick re-resolve can reuse
# it: prints "ip port" when NAME is advertising on AirPlay, nothing otherwise.
# || true so a missing avahi-browse degrades to "not found" (clear die) rather
# than a set -e pipeline error.
# Every service block starts with a "=" header line, so the header re-matches
# grab each time: a partial record for NAME (address but no port) must resolve
# to nothing — NOT bleed into the next service's lines and "resolve" NAME to
# another TV's ip:port.
match_target() {
    local name="$1" out
    out="$(avahi-browse -rt _airplay._tcp -t 2>/dev/null | awk -v n="$name" '
        $1 == "=" { grab = ($4 == n); next }
        grab && /address =/ { gsub(/[][]/, ""); sub(/^.*address = /, ""); ip = $0 }
        grab && /port =/    { gsub(/[][]/, ""); sub(/^.*port = /, "");    port = $0 }
        grab && ip != "" && port != "" { print ip, port; exit }')" || true
    [ -n "$out" ] || return 0
    # The record can outlive the TV (stale cache). A dead endpoint must read
    # as "not found" so the caller prompts or dies with the friendly message
    # instead of hanging while the stream dials a ghost.
    if tv_alive "${out% *}" "${out#* }"; then
        printf '%s\n' "$out"
    fi
}

# Resolve the TV's IP + AirPlay port from mDNS (avahi). TV must be powered on.
# Sets TARGET_IP and TARGET_PORT (Samsung picks a dynamic AirPlay port, e.g. 51820, not 7000).
#
# Rescue prompt fires ONLY when the configured TV is missing — never while it
# resolves (switching between two live TVs is `samcast tv`'s job) — and only
# on a TTY; keybindings/scripts keep the plain die. A picked name is
# re-resolved exactly once below: if it fails too, control falls to the die
# (with the new name) instead of looping.
resolve_target() {
    local out
    out="$(match_target "$SAMCAST_NAME")"
    if [ -z "$out" ] && [ -t 0 ] && select_tv; then
        out="$(match_target "$SAMCAST_NAME")"
    fi
    [ -n "$out" ] || die "'$SAMCAST_NAME' not found on the network (is the TV on and on Wi-Fi?)"
    TARGET_IP="${out% *}"; TARGET_PORT="${out#* }"
}

stream_flags() {
    printf -- '-fps %s -hwaccel %s -port-range %s %s' \
        "$SAMCAST_FPS" "$SAMCAST_HWACCEL" "$SAMCAST_PORT_RANGE" "$SAMCAST_EXTRA_FLAGS"
}

cmd_discover() {
    local rows name ip port model fw
    echo "Samsung AirPlay receivers on this network:"
    rows="$(scan_tvs)"
    while IFS=$'\t' read -r name ip port model fw; do
        [ -n "$name" ] || continue  # empty scan -> one empty herestring line
        # scan_tvs applied the /^U/ Samsung filter; this keeps discover's
        # historical columns (fw prints empty when the TV omits fv=). Raw
        # mDNS view: no liveness probing here, `samcast tvs` is the
        # can-I-cast view.
        printf '  %-10s %-15s model=%-10s fw=%s\n' "$name" "$ip" "$model" "$fw"
    done <<<"$rows"
}

cmd_target() { resolve_target; echo "$TARGET_IP:$TARGET_PORT"; }

cmd_pair() {
    resolve_target
    echo "Pairing with $SAMCAST_NAME ($TARGET_IP:$TARGET_PORT). Check the TV for the PIN."
    # shellcheck disable=SC2086
    exec "$DOUBLETAKE" -target "$TARGET_IP" -port "$TARGET_PORT" -pair $(stream_flags)
}

# Keep xdg-desktop-portal-hyprland casting headlessly: point its
# `custom_picker_binary` at our samcast-picker. xdph reads xdph.conf only at
# portal startup — hence the service restart below, and only when the file
# content actually changed (the picker itself re-reads the config per cast, so
# monitor changes never need a restart). A key pointing at a previous
# extraction dir's samcast-picker (the dist image rotates on every update —
# a stale path survives only until the cache is cleared) is ours to reclaim;
# a genuinely foreign picker is left alone with a warning.
ensure_picker() {
    local key="screencopy:custom_picker_binary"
    local want="$SCRIPT_DIR/samcast-picker"
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
    local conf="$dir/xdph.conf" have=""

    [ -n "${WAYLAND_DISPLAY:-}" ] || return 0  # X11 fallback: no xdph involved
    [ -x "$want" ] || {
        echo "samsung-cast: warning: $want missing or not executable — leaving $conf alone" >&2
        return 0
    }

    if [ -f "$conf" ]; then
        have="$(grep -m1 "^${key}[[:space:]]*=" "$conf" 2>/dev/null |
            sed 's/^[^=]*=[[:space:]]*//;s/[[:space:]]*$//' || true)"
        if [ "$have" = "$want" ]; then
            return 0  # already ours — nothing to do
        fi
        if [ -n "$have" ] && [ "${have##*/}" != "samcast-picker" ]; then
            echo "samsung-cast: warning: $conf already sets $key to '$have' — not clobbering it" >&2
            return 0
        fi
        # Ours (a stale extraction dir from an earlier image, or an empty
        # value): rewrite in place — drop the key's lines, re-append. grep -v
        # + append keeps $want's characters (SCRIPT_DIR could contain odd
        # ones) out of sed replacement territory entirely.
        grep -v "^${key}[[:space:]]*=" "$conf" > "$conf.tmp.$$" 2>/dev/null || true
        printf '%s = %s\n' "$key" "$want" >> "$conf.tmp.$$"
        mv "$conf.tmp.$$" "$conf"
    else
        mkdir -p "$dir"
        {
            echo "# samsung-cast manages the ${key} key below (headless cast picker; see: samcast monitor)"
            printf '%s = %s\n' "$key" "$want"
        } > "$conf"
    fi
    echo "samsung-cast: set $key in $conf — restarting xdg-desktop-portal-hyprland.service"
    systemctl --user restart xdg-desktop-portal-hyprland.service 2>/dev/null ||
        echo "samsung-cast: warning: restarting xdg-desktop-portal-hyprland.service failed — log out/in or restart it" >&2
}

# First-cast terminal prompt: with several monitors connected and none
# configured, ask once and persist the answer, so later casts (and the xdph
# picker) stay dialog-free. No-op when not a terminal, ≤1 monitor, or already
# configured — keybinding-safe.
select_monitor() {
    if [ -n "$SAMCAST_MONITOR" ] || [ ! -t 0 ]; then
        return 0
    fi
    local names name count=0 i=1 pick chosen
    local -a opts=()
    names="$(list_monitors)"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        opts+=("$name")
        count=$((count + 1))
    done <<<"$names"
    if [ "$count" -lt 2 ]; then
        return 0
    fi
    echo "More than one monitor connected — pick the one to cast:"
    for name in "${opts[@]}"; do
        printf '  [%d] %s\n' "$i" "$name"
        i=$((i + 1))
    done
    if ! read -r -p "Monitor to cast [1]: " pick; then
        return 0  # stdin closed mid-prompt — stay on auto
    fi
    [ -n "$pick" ] || pick=1  # empty answer takes the default
    if [ "$pick" -eq "$pick" ] 2>/dev/null && [ "$pick" -ge 1 ] && [ "$pick" -le "$count" ]; then
        chosen="${opts[$((pick - 1))]}"
    else
        echo "samsung-cast: '$pick' is not a menu option — keeping auto" >&2
        return 0
    fi
    set_config_var SAMCAST_MONITOR "$chosen"
    SAMCAST_MONITOR="$chosen"
    echo "will cast '$chosen' (change: samcast monitor <NAME>; revert: samcast monitor auto)"
}

cmd_start() {
    ensure_picker
    if systemctl --user is-active --quiet "$UNIT"; then
        echo "daemon already running"
    else
        # DOUBLETAKE_MONITOR pins the X11 capture monitor (Go-engine contract);
        # Wayland ignores it — its selection is xdph's picker. The daemon env
        # is fixed at spawn, so pass it only when set.
        local -a envs=(--setenv="DOUBLETAKE_TIMING=$DOUBLETAKE_TIMING")
        if [ -n "$SAMCAST_MONITOR" ]; then
            envs+=(--setenv="DOUBLETAKE_MONITOR=$SAMCAST_MONITOR")
        fi
        systemd-run --user --unit="$UNIT" "${envs[@]}" \
            --description="samsung-cast AirPlay mirroring daemon" \
            "$DOUBLETAKE" -daemonize -port-range "$SAMCAST_PORT_RANGE" \
            -fps "$SAMCAST_FPS" -hwaccel "$SAMCAST_HWACCEL" $SAMCAST_EXTRA_FLAGS
    fi
    for _ in $(seq 1 40); do [ -S "$SOCK" ] && break; sleep 0.25; done
    [ -S "$SOCK" ] || die "daemon socket $SOCK never appeared (journalctl --user -u $UNIT)"
    "$CTL" status
}

cmd_stop()   {
    "$CTL" disconnect 2>/dev/null || true
    systemctl --user stop "$UNIT" 2>/dev/null || true
    echo "stopped"
}
cmd_status() { "$CTL" status 2>/dev/null || die "daemon not running (samcast start)"; }
cmd_devices(){ "$CTL" devices 2>/dev/null || die "daemon not running (samcast start)"; }

cmd_monitors() {
    # --raw (UI contract): names only, one per line — sole argument only.
    local raw=""
    if [ "${1:-}" = "--raw" ]; then raw=1; shift; fi
    [ $# -eq 0 ] || die "unknown argument: $1"
    local names name i=0 suffix
    names="$(list_monitors)"
    [ -n "$names" ] || die "no monitors found (Wayland needs hyprctl + a Hyprland session; X11 needs xrandr + DISPLAY)"
    if [ -n "$raw" ]; then
        printf '%s\n' "$names"
        return
    fi
    echo "Monitors:"
    while IFS= read -r name; do
        i=$((i + 1))
        suffix=""
        if [ "$name" = "$SAMCAST_MONITOR" ]; then suffix=" (configured)"; fi
        printf '  [%d] %s%s\n' "$i" "$name" "$suffix"
    done <<<"$names"
}

# samcast monitor — show or persist which monitor to cast (SAMCAST_MONITOR).
cmd_monitor() {
    # --raw (UI contract): the configured name, or "auto" spelled out — sole argument only.
    if [ "${1:-}" = "--raw" ]; then
        shift
        [ $# -eq 0 ] || die "unknown argument: $1"
        echo "${SAMCAST_MONITOR:-auto}"
        return
    fi
    local name="${1:-}"
    if [ -z "$name" ]; then
        if [ -n "$SAMCAST_MONITOR" ]; then
            echo "$SAMCAST_MONITOR"
        else
            echo "auto (choose in the portal dialog)"
        fi
        echo "set with: samcast monitor <NAME> (samcast monitors lists them; samcast monitor auto reverts)"
        return
    fi
    if [ "$name" = "auto" ]; then
        set_config_var SAMCAST_MONITOR ""
        SAMCAST_MONITOR=""
        echo "monitor selection: auto — the share-picker dialog shows on each cast"
        return
    fi
    # Output names (eDP-1, DP-1, HDMI-A-1...) are [A-Za-z0-9_-]; anything else
    # would corrupt the sourced config line or the xdph [SELECTION] answer.
    case "$name" in
        *[!A-Za-z0-9_-]*) die "invalid monitor name '$name' (letters, digits, '-' and '_' only, e.g. eDP-1)" ;;
    esac
    # Not currently connected is not fatal — allow setting anyway (the monitor
    # may be undocked now but docked again before the next cast; xdph's picker
    # falls back to the GUI until then).
    if ! list_monitors | grep -Fxq "$name"; then
        echo "samsung-cast: note: '$name' is not connected right now — set anyway (it may be docked again before the next cast)" >&2
    fi
    set_config_var SAMCAST_MONITOR "$name"
    SAMCAST_MONITOR="$name"
    echo "will cast monitor '$name' ('samcast monitor auto' reverts; 'samcast monitors' lists)"
}

# samcast tvs — the LAN, numbered like cmd_monitors, configured TV marked,
# merged with the saved list: TVs picked earlier stay listed (greyed in the
# UI) when standby dropped them, so they can be re-pinned or forgotten.
cmd_tvs() {
    # --raw (UI contract): name<TAB>ip<TAB>model<TAB>state per row — state is
    # "live" or "saved", and saved rows leave ip/model empty (two tabs). No
    # header or hint — sole argument only. Dies only when the MERGED list
    # (live + saved + configured) is entirely empty: a TV-less LAN with a
    # configured TV still has something to show.
    local raw=""
    if [ "${1:-}" = "--raw" ]; then raw=1; shift; fi
    [ $# -eq 0 ] || die "unknown argument: $1"
    local rows known combined="" live="" name ip model state i=0 suffix
    rows="$(list_tvs_alive)"  # a stale advertised record reports as saved, not live
    known="$(known_tvs)"
    [ -n "$rows" ] || [ -n "$known" ] || [ -n "${SAMCAST_NAME:-}" ] ||
        die "no Samsung TVs discovered (is a TV powered on? standby drops its Wi-Fi)"
    while IFS=$'\t' read -r name ip model; do
        [ -n "$name" ] || continue  # empty scan -> one empty herestring line
        combined+="$name"$'\t'"$ip"$'\t'"$model"$'\t'"live"$'\n'
        live+="$name"$'\n'
    done <<<"$rows"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        if printf '%s' "$live" | grep -Fxq -e "$name"; then continue; fi
        combined+="$name"$'\t\t\tsaved'$'\n'
    done <<<"$known"
    # The configured name backfills when it is neither live nor saved (a
    # config predating the saved list, say) — it must never go invisible.
    if [ -n "${SAMCAST_NAME:-}" ] &&
        ! printf '%s' "$live" | grep -Fxq -e "$SAMCAST_NAME" &&
        ! printf '%s' "$known" | grep -Fxq -e "$SAMCAST_NAME"; then
        combined+="$SAMCAST_NAME"$'\t\t\tsaved'$'\n'
    fi
    if [ -n "$raw" ]; then
        printf '%s' "$combined"
        return
    fi
    echo "TVs:"
    while IFS=$'\t' read -r name ip model state; do
        [ -n "$name" ] || continue
        i=$((i + 1))
        suffix=""
        if [ "$name" = "$SAMCAST_NAME" ]; then suffix=" (configured)"; fi
        if [ "$state" = "live" ]; then
            printf '  [%d] %s  %s  model=%s%s\n' "$i" "$name" "$ip" "$model" "$suffix"
        else
            printf '  [%d] %s  saved — not on the network%s\n' "$i" "$name" "$suffix"
        fi
    done <<<"$combined"
    echo "set with: samcast tv <NAME>"
}

# samcast tv — show or persist which TV to cast (SAMCAST_NAME). The mDNS
# service name IS the TV identity the config carries; unlike monitors there is
# no auto — a name is always required (no per-cast picker exists for TVs).
# --forget NAME drops a name from the saved list only; SAMCAST_NAME stands.
cmd_tv() {
    # --raw (UI contract): the bare name, exit 0 always (no "(none)" placeholder,
    # no discovery round-trip) — sole argument only.
    if [ "${1:-}" = "--raw" ]; then
        shift
        [ $# -eq 0 ] || die "unknown argument: $1"
        echo "$SAMCAST_NAME"
        return
    fi
    # --forget consumes the NEXT argument as the name and only edits the saved
    # list — the casting config (SAMCAST_NAME) is deliberately left intact.
    if [ "${1:-}" = "--forget" ]; then
        shift
        [ $# -ge 1 ] || die "tv --forget needs a name ('samcast tvs' lists the saved ones)"
        local forgotten="$1"
        shift
        [ $# -eq 0 ] || die "unknown argument: $1"
        tv_name_ok "$forgotten" ||
            die "invalid TV name '$forgotten' ('|', '\"', '\$', '\`', '\\', '&' and newlines would corrupt the config; spaces are fine)"
        forget_known_tv "$forgotten"
        if [ "$forgotten" = "$SAMCAST_NAME" ]; then
            echo "forgot '$forgotten' — it is still the configured TV — set another with: samcast tv <NAME>"
        else
            echo "forgot '$forgotten'"
        fi
        return
    fi
    local name="${1:-}"
    if [ -z "$name" ]; then
        if [ -n "$SAMCAST_NAME" ]; then
            echo "$SAMCAST_NAME"
        else
            echo "(none)"
        fi
        echo "set with: samcast tv <NAME> (samcast tvs lists them)"
        return
    fi
    tv_name_ok "$name" ||
        die "invalid TV name '$name' ('|', '\"', '\$', '\`', '\\', '&' and newlines would corrupt the config; spaces are fine)"
    # Not on the network right now is not fatal — standby drops the TV's
    # Wi-Fi; allow setting anyway (it may be powered on before the next cast).
    if ! list_tvs_alive | cut -f1 | grep -Fxq -e "$name"; then
        echo "samsung-cast: note: '$name' is not on the network right now — set anyway (run 'samcast tvs' once it is powered on)" >&2
    fi
    set_config_var SAMCAST_NAME "$name"
    SAMCAST_NAME="$name"
    # select_tv's rescue prompt saves too — both sites exist so ANY path that
    # pins a TV remembers it, and tvs keeps it listed once it goes offline.
    save_known_tv "$name"
    echo "will cast '$name' ('samcast pair' is needed the first time this TV is used; 'samcast tvs' lists)"
}

cmd_on() {
    local pin="${1:-}"
    resolve_target
    ensure_picker  # Wayland: keep xdph pointed at samcast-picker (idempotent)
    # Picking once here (first interactive cast with >1 monitor, nothing
    # configured) makes every later cast dialog-free: xdph re-runs its picker
    # per request and the stored choice short-circuits it.
    select_monitor

    if systemctl --user is-active --quiet "$UNIT"; then
        # The daemon's env is fixed at spawn. If its recorded DOUBLETAKE_MONITOR
        # (the X11 capture monitor — Wayland ignores it) drifted from the
        # current choice, restart so the change takes effect. Desired value is
        # absent when SAMCAST_MONITOR is empty (auto).
        local want="${SAMCAST_MONITOR:-}" have=""
        have="$(systemctl --user show "$UNIT" -p Environment 2>/dev/null |
            sed -n 's/^Environment=//p' | tr ' ' '\n' |
            sed -n 's/^DOUBLETAKE_MONITOR=//p' || true)"
        if [ "$have" != "$want" ]; then
            echo "samsung-cast: capture monitor changed (${have:-auto} -> ${want:-auto}) — restarting the daemon"
            "$CTL" disconnect 2>/dev/null || true
            systemctl --user stop "$UNIT" 2>/dev/null || true
            cmd_start
        fi
    else
        cmd_start >/dev/null
    fi
    # The daemon resolves the AirPlay port from its own mDNS cache; wait until
    # the TV shows up there (a freshly started daemon needs a few seconds).
    local _
    for _ in $(seq 1 40); do
        "$CTL" devices 2>/dev/null | grep -Fq "$TARGET_IP" && break
        sleep 0.5
    done
    echo "Mirroring to $SAMCAST_NAME ($TARGET_IP:$TARGET_PORT)..."
    if [ -n "$pin" ]; then "$CTL" connect "$TARGET_IP" "$pin"; else "$CTL" connect "$TARGET_IP"; fi
}

cmd_off()   {
    "$CTL" disconnect 2>/dev/null || true
    echo "mirroring stopped"
}

cmd_toggle() {
    resolve_target
    if "$CTL" status 2>/dev/null | grep -Fq "$TARGET_IP"; then cmd_off; else cmd_on; fi
}

cmd_log() { journalctl --user -u "$UNIT" "$@"; }

# One GET /api/health against 127.0.0.1:$1 via bash's /dev/tcp (no curl
# dependency). Prints the peer's first response line (e.g. "HTTP/1.0 200 OK")
# and returns 0 when something answered; 1 when the connection was refused
# (nothing listening); 2 when the port accepted but sent nothing for 5s — an
# open port that is not talking HTTP must NOT look like a free port, or a
# second server would just crash-bind on it. The read timeout keeps a hung
# listener from stalling the launch.
ui_health_status() {
    local port="$1" line=""
    # bash prints /dev/tcp failures before a trailing 2>/dev/null applies
    # (redirections are processed left-to-right), so the silencing is scoped to
    # this group; the fd 3 it opens persists past the closing brace.
    { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null || return 1
    printf 'GET /api/health HTTP/1.0\r\n\r\n' >&3 2>/dev/null || true
    IFS= read -r -u 3 -t 5 line || true
    exec 3>&-
    [ -n "$line" ] || return 2
    printf '%s\n' "$line"
}

# Status line -> HTTP code ("HTTP/1.0 200 OK" -> 200); anything non-HTTP or
# empty becomes something that is never "200", so callers can just compare.
ui_health_code() {
    local status="${1%%$'\r'}"
    status="${status#* }"   # drop "HTTP/1.x"
    status="${status%% *}"  # keep the code word only
    printf '%s\n' "$status"
}

# Open the control panel as a desktop window. Wayland first-class here
# (WAYLAND_DISPLAY set): chromium/google-chrome-stable --app gives a standalone
# window, and --class sets the Wayland app_id — Hyprland matches windowrules
# against it (class samsung-cast; see the float rule documented in README).
# No --ozone-platform flags: modern Chromium auto-detects Wayland. Firefox has
# no app mode — a plain new window. setsid + silenced stdio: fire-and-forget,
# the window must survive this script's exit and its Ctrl-C (a new session
# keeps it out of the terminal's SIGINT process group). No browser at all:
# cmd_ui has already printed the URL, just say so.
ui_open_window() {
    local url="$1"
    if command -v chromium >/dev/null 2>&1; then
        setsid chromium --app="$url" --class=samsung-cast </dev/null >/dev/null 2>&1 &
    elif command -v google-chrome-stable >/dev/null 2>&1; then
        setsid google-chrome-stable --app="$url" --class=samsung-cast </dev/null >/dev/null 2>&1 &
    elif command -v firefox >/dev/null 2>&1; then
        setsid firefox --new-window "$url" </dev/null >/dev/null 2>&1 &
    else
        echo "samsung-cast: no chromium/google-chrome/firefox found — open $url in a browser" >&2
    fi
}

# --browser: skip the app window, hand the URL to the desktop default handler.
ui_open_browser_tab() {
    local url="$1"
    setsid xdg-open "$url" </dev/null >/dev/null 2>&1 &
}

# Desktop entry so wofi/rofi/app-grids list "Samsung Cast". Exec carries the
# ABSOLUTE samcast path: launchers do not share this shell's cwd. Idempotent —
# rewritten only when missing or differing (differing content is updated: this
# file is ours to own); byte-identical content means no rewrite churn, which
# launchers watching directory mtimes appreciate. Icon=video-display is a
# freedesktop-standard name, always resolvable. Only the file written here is
# ever chmodded.
ensure_desktop_entry() {
    local dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local file="$dir/samsung-cast.desktop"
    # Prefer a stable launcher on PATH over $SCRIPT_DIR: when this runs from
    # the single-file app, SCRIPT_DIR is the cache extraction dir, which
    # rotates with every image update and can be wiped — an entry pointing
    # there breaks until a terminal run re-extracts. ~/.local/bin/samcast
    # re-extracts itself, so the entry survives both.
    local exec="$SCRIPT_DIR/samcast" onpath
    onpath="$(command -v samcast 2>/dev/null || true)"
    [ -n "$onpath" ] && [ "$onpath" != "$SCRIPT_DIR/samcast" ] && exec="$onpath"
    local want have
    # Quote the Exec path: the desktop-entry spec and systemd both parse
    # double quotes, so a space in the install path stays one argument.
    want="[Desktop Entry]
Type=Application
Name=Samsung Cast
Exec=\"$exec\" ui
Terminal=false
Categories=Utility;AudioVideo
Icon=video-display
StartupWMClass=samsung-cast"
    mkdir -p "$dir"
    have="$(cat "$file" 2>/dev/null || true)"
    if [ "$have" = "$want" ]; then
        return 0
    fi
    printf '%s\n' "$want" > "$file"
    chmod 644 "$file"
    echo "samsung-cast: wrote $file"
}

# samcast ui — serve the control panel (bin/samcast-ui, built by make) and
# open its window. The server binds 127.0.0.1 only: no auth, same-user
# same-machine trust. An instance already listening is reused after a 200 on
# /api/health; a port answering anything else belongs to someone else —
# refused with a port hint, never killed.
cmd_ui() {
    local port=8791 open=app   # open: app window | browser tab | none (--no-open)
    while [ $# -gt 0 ]; do
        case "$1" in
            --port)
                [ $# -ge 2 ] || die "--port needs a number"
                case "$2" in ''|*[!0-9]*) die "--port wants a number, got '$2'" ;; esac
                port="$2"
                shift
                ;;
            --no-open) open=none ;;
            --browser) open=browser ;;
            *) die "unknown argument: $1" ;;
        esac
        shift
    done
    local url="http://127.0.0.1:$port"

    [ -x "$UI_BIN" ] || die "UI server not built — run: make"
    ensure_desktop_entry

    # Reuse probe BEFORE starting: 200 on /api/health means a server of ours
    # is already up (an earlier samcast ui / launcher run) — just show the
    # window. Refused = free port, start one below. Any other answer, or a
    # port that accepts without speaking HTTP, is something else: die rather
    # than kill it or stack a second server on top.
    local status="" rc=0 code ui_pid=""
    status="$(ui_health_status "$port")" || rc=$?
    if [ "$rc" -eq 0 ] && [ "$(ui_health_code "$status")" != "200" ]; then
        die "port $port is in use by something else (try: samcast ui --port N)"
    elif [ "$rc" -eq 2 ]; then
        die "port $port is in use by something else (try: samcast ui --port N)"
    fi

    if [ "$rc" -ne 0 ]; then  # refused — free port, ours to claim
        echo "samsung-cast: starting UI server on $url"
        # Not exec: the window may only open once /api/health answers, and
        # wait below keeps Ctrl-C killing both this script and the server.
        "$UI_BIN" --samcast "$SCRIPT_DIR/samcast" --ctl "$CTL" --addr "127.0.0.1:$port" &
        ui_pid=$!
        trap 'kill "$ui_pid" 2>/dev/null || true' EXIT
        local up=""
        for _ in $(seq 1 50); do
            sleep 0.1
            kill -0 "$ui_pid" 2>/dev/null || break  # died at bind — its error is on our stderr
            status="$(ui_health_status "$port")" || true
            if [ -n "$status" ] && [ "$(ui_health_code "$status")" = "200" ]; then
                up=1
                break
            fi
        done
        [ -n "$up" ] || die "UI server did not come up on $url (its error is above; try: samcast ui --port N)"
    fi

    echo "samsung-cast UI: $url"
    case "$open" in
        app)     ui_open_window "$url" ;;
        browser) ui_open_browser_tab "$url" ;;
        none)    ;;  # --no-open: URL printed above, nothing opened
    esac

    # A reused server is not ours to hold (exit 0 immediately); ours is held:
    # this foreground wait is what keeps Ctrl-C taking the server down too.
    if [ -n "$ui_pid" ]; then
        wait "$ui_pid"
    fi
}

# samcast tray — the bar icon (waybar hosts the freedesktop StatusNotifierItem
# protocol). It reflects the mirroring state and can open the panel or start/
# stop mirroring even when the panel window is closed. Bare `samcast tray`
# runs the helper in the FOREGROUND via exec: that is what the systemd unit
# calls, and exec lets systemd supervise the helper itself rather than a bash
# wrapper. enable/disable/status manage the unit.
cmd_tray() {
    local unit="samsung-cast-tray.service"
    local sysdir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    local file="$sysdir/$unit"
    case "${1:-run}" in
        run)
            [ -x "$TRAY_BIN" ] || die "tray helper not built — run: make"
            exec "$TRAY_BIN" --samcast "$SCRIPT_DIR/samcast" --ctl "$CTL"
            ;;
        enable)
            [ -x "$TRAY_BIN" ] || die "tray helper not built — run: make"
            local before after was_active=0
            before="$(cat "$file" 2>/dev/null || true)"
            systemctl --user is-active --quiet "$unit" 2>/dev/null && was_active=1
            ensure_tray_service
            after="$(cat "$file" 2>/dev/null || true)"
            systemctl --user daemon-reload
            systemctl --user enable --now "$unit"
            # enable --now leaves a running service untouched; a rewritten unit
            # (samcast moved on PATH) needs a restart to pick up the new ExecStart
            if [ "$before" != "$after" ] && [ "$was_active" = 1 ]; then
                systemctl --user try-restart "$unit"
            fi
            echo "samsung-cast: tray is $(systemctl --user is-active "$unit")"
            ;;
        disable)
            systemctl --user disable --now "$unit" 2>/dev/null || true
            echo "samsung-cast: tray disabled (icon gone until: samcast tray enable)"
            ;;
        status)
            local en
            en="$(systemctl --user is-enabled "$unit" 2>/dev/null || true)"
            [ "$en" = "enabled" ] || en=disabled
            printf 'unit:    %s\n' "$(systemctl --user is-active "$unit" 2>/dev/null || echo inactive)"
            printf 'enabled: %s\n' "$en"
            if systemctl --user is-active --quiet "$unit" 2>/dev/null &&
                busctl --user list 2>/dev/null | grep -q "org.kde.StatusNotifierItem"; then
                echo "icon:    registered on the session bus"
            else
                echo "icon:    not registered (is a bar with a tray module running?)"
            fi
            ;;
        *) die "unknown argument: $1 (use: enable, disable, status)" ;;
    esac
}

# Install ~/.config/systemd/user/samsung-cast-tray.service. Exec carries the
# ABSOLUTE samcast path (launchers/systemd do not share this shell's cwd), and
# prefers a stable samcast on PATH over $SCRIPT_DIR: when this runs from the
# single-file app, SCRIPT_DIR is the cache extraction dir, which rotates with
# every image update — the same rule as the desktop entry. PartOf ties the
# helper to the graphical session; Restart=on-failure restarts crashes but a
# clean Quit (or logout) stays down.
ensure_tray_service() {
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    local file="$dir/samsung-cast-tray.service"
    local exec="$SCRIPT_DIR/samcast" onpath
    onpath="$(command -v samcast 2>/dev/null || true)"
    [ -n "$onpath" ] && [ "$onpath" != "$SCRIPT_DIR/samcast" ] && exec="$onpath"
    local want have
    want="[Unit]
Description=samsung-cast tray icon
PartOf=graphical-session.target

[Service]
ExecStart=\"$exec\" tray
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target"
    mkdir -p "$dir"
    have="$(cat "$file" 2>/dev/null || true)"
    if [ "$have" = "$want" ]; then
        return 0
    fi
    printf '%s\n' "$want" > "$file"
    chmod 644 "$file"
    echo "samsung-cast: wrote $file"
}

cmd="${1:-}"; shift || true
case "$cmd" in
    discover) cmd_discover ;;
    target)   cmd_target ;;
    pair)     cmd_pair ;;
    start)    cmd_start ;;
    stop)     cmd_stop ;;
    status)   cmd_status ;;
    devices)  cmd_devices ;;
    monitors) cmd_monitors "$@" ;;
    monitor)  cmd_monitor "$@" ;;
    tvs)      cmd_tvs "$@" ;;
    tv)       cmd_tv "$@" ;;
    on)       cmd_on "$@" ;;
    mirror)   cmd_on "$@" ;;
    off)      cmd_off ;;
    toggle)   cmd_toggle ;;
    log)      cmd_log "$@" ;;
    ui)       cmd_ui "$@" ;;
    tray)     cmd_tray "$@" ;;
    *)        usage; [ "$cmd" = "" ] || die "unknown command: $cmd" ;;
esac
